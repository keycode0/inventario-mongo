# ==========================
# DJANGO CORE
# ==========================
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=config.settings.dev

# ==========================
# DJANGO NETWORK
# ==========================
DJANGO_ALLOWED_HOSTS=*

# ==========================
# MONGODB
# ==========================
MONGO_DB_NAME=inventory
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=

# ==========================
# TIMEZONE & LOCALE
# ==========================
DJANGO_TIME_ZONE=America/Guayaquil
DJANGO_LANGUAGE_CODE=es-ec
